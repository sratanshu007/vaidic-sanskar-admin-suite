# -----------------------------------------------------------------------------
# Root .gitignore for vaidic-sanskar-admin-suite
# -----------------------------------------------------------------------------

# Sensitive & Secret Files
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
*.pem
*.key
*.cert
*.crt
*.jks
*.p12

# Environment Variables
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.local

# Dependencies
node_modules/
**/node_modules/

# Uploaded Media & Files
public/uploads/*
!public/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# IDE and Editor configurations
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
