# VaidicSanskar — Environment Configuration Template

# Server Port & Secrets
PORT=4000
JWT_SECRET=your-secret-key-here
ADMIN_EMAIL=admin@vaidicsanskar.com
ADMIN_PASSWORD=your-secure-admin-password
CORS_ORIGIN=*

# MongoDB Database URI (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vaidic_sanskar?retryWrites=true&w=majority

# Cloudinary Storage Configuration (for verification documents & photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration for OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Vaidic Sanskar" <your_email@gmail.com>

# Mappls (MapmyIndia) Integration Keys
EXPO_PUBLIC_MAPPLS_REST_KEY=your_mappls_rest_key
EXPO_PUBLIC_MAPPLS_CLIENT_ID=your_mappls_client_id
EXPO_PUBLIC_MAPPLS_CLIENT_SECRET=your_mappls_client_secret

# Agora RTC Live Video & Audio In-App Calling (Production App ID & Primary Certificate)
AGORA_APP_ID=your_agora_app_id
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_primary_certificate_here
